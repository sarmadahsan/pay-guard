# Wallet private keys (0x-prefixed hex). LEAVE EMPTY: scripts/setup_wallets.py generates any empty key.
# NEVER commit the real .env. Never paste a known/test key such as 0x...0001 here: anyone can sweep it.
BUYER_KEY_SEPOLIA=
BUYER_KEY_MAINNET=
FACILITATOR_KEY_SEPOLIA=
SELLER_KEY_SEPOLIA=
SELLER_PAY_TO=

# Sellers
SELLER_BASE_URL=http://127.0.0.1:8402
SELLER_FACILITATOR=remote            # remote | local
FACILITATOR_URL=https://x402.org/facilitator
SELLER_STALL_S=90
# Truncation demo: comma-separated route prefixes whose settled body the seller cuts to 60% (e.g. /convert or /report).
# Empty = off. PayGuard's not_truncated validator then reports 🔴 "pdf truncated (no %%EOF ...)". See docs/pay-guard/demo/truncation.md.
SELLER_TRUNCATE_PATHS=

# Meridian Intel (hackathon demo): the adversarial seller from the sibling litigious-seller repo, run on port 8403 because
# both seller apps default to 8402. Leave empty to disable the get_intel_report tool. See docs/pay-guard/demo/meridian.md.
INTEL_BASE_URL=http://127.0.0.1:8403

# Chain RPC
RPC_URL_SEPOLIA=https://sepolia.base.org
RPC_URL_MAINNET=https://mainnet.base.org

# PayGuard
PAYGUARD_STORE=sqlite               # sqlite | supabase
PAYGUARD_SQLITE_PATH=payguard.db
PAYGUARD_ARTIFACT_DIR=artifacts
PAYGUARD_POLICY=policy.yaml
PAYGUARD_LOG_LEVEL=INFO

# Supabase (M6)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Bazaar seller (M7): a public x402 seller on Base mainnet (eip155:8453), exposed as a fourth paid tool.
# Fill from: uv run python scripts/bazaar_probe.py --pick <resource_url>
# Leave BAZAAR_URL empty to disable the fourth tool. Requires BUYER_KEY_MAINNET above (real funds).
BAZAAR_URL=
BAZAAR_PAY_TO=
# Price in integer USDC minor units (6 decimals, e.g. 10000 = $0.01); must be positive or the tool is skipped.
BAZAAR_PRICE_MINOR=
BAZAAR_CONTENT_TYPE=application/json
BAZAAR_TOOL_NAME=get_public_data
